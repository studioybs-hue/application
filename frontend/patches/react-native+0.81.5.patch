       [inv invokeWithTarget:strongModule];
     } @catch (NSException *exception) {
-      throw convertNSExceptionToJSError(runtime, exception, std::string{moduleName}, methodNameStr);
+      // iOS 26 / RN 0.81 New Architecture crash fix — backport of facebook/react-native#56694.
+      // Void TurboModule methods run on a BACKGROUND native queue, so converting an NSException
